# =====================================================================
# DIGITAL WATCHDOG - PRODUCTION ENVIRONMENT CONFIGURATION
# Copy this file to .env and configure all secrets before deploying
# =====================================================================

# Server Configuration
PORT=5000
NODE_ENV=production

# MySQL Database Configuration (utf8mb4 connection pool)
DB_HOST=localhost
DB_PORT=3306
DB_USER=digital_watchdog_user
DB_PASSWORD=your_strong_mysql_password
DB_NAME=digital_watchdog_db
DB_CONNECTION_LIMIT=20

# Security & Authentication (Generate using: openssl rand -base64 64)
JWT_SECRET=your_super_secure_random_jwt_secret_key_at_least_64_chars_long
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# Client Application URL for Strict CORS Enforcement
# Multiple origins can be comma-separated or set to your primary web domain
CORS_ORIGIN=https://app.digitalwatchdog.ng
APP_BASE_URL=https://app.digitalwatchdog.ng
API_BASE_URL=https://api.digitalwatchdog.ng

# Cloudinary Private Object Storage (Receipts, Waybills, Invoices & Biometrics)
# Providers: 'cloudinary' (recommended for production) or 'local'
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Paystack Banking & NUBAN Central Switch Gateway (https://paystack.com)
PAYSTACK_SECRET_KEY=sk_live_your_paystack_secret_key
USE_MOCK_VERIFICATION=false

# Robase SMS OTP Gateway (https://robase.dev)
ROBASE_BASE_URL=https://api.robase.dev
ROBASE_API_KEY=your_robase_api_key
ROBASE_SMS_SENDER_ID=WATCHDOG
MOCK_SMS=false
SMS_PROVIDER=robase

# Dojah Identity & Biometrics KYC/KYB Gateway (https://dojah.io)
DOJAH_BASE_URL=https://api.dojah.io
DOJAH_API_KEY=your_live_dojah_api_key
DOJAH_APP_ID=your_live_dojah_app_id
DOJAH_ENV=production

# WhatsApp Business Bot (Meta Cloud API)
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_meta_waba_account_id
WHATSAPP_API_TOKEN=your_meta_cloud_api_token
WHATSAPP_VERIFY_TOKEN=your_custom_webhook_verification_token
WHATSAPP_API_VERSION=v19.0
USE_WHATSAPP_MOCK=false

# Telegram Business Bot (BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
TELEGRAM_BOT_USERNAME=DigitalWatchdogBot
USE_TELEGRAM_MOCK=false

# Transactional Email Engine (SMTP / Resend / SendGrid)
EMAIL_FROM="Digital Watchdog Escrow" <alerts@digitalwatchdog.ng>
EMAIL_SUPPORT=support@digitalwatchdog.ng
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_smtp_api_key
USE_EMAIL_MOCK=false

# World Wide Security (WWS) Global Coordination Gateway
WWS_API_BASE_URL=https://api.worldwidesecurity.io/v1
DIGITAL_WATCHDOG_HMAC_SECRET=your_wws_shared_hmac_secret_token
